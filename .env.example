# Copy to .env for local development. Never commit real secrets.

# Telegram bot
TELEGRAM_TOKEN=replace-with-bot-token

# PostgreSQL / privacy identity
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://avvalo:avvalo@localhost:5432/avvalo
APP_HMAC_SECRET=replace-with-at-least-32-random-characters

# Through a neutral OpenAI-compatible host
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-provider-api-key
# Prefer a dated snapshot id over a bare or `-latest` one: OpenRouter retires
# model ids (qwen/qwen-2.5-72b-instruct, used here until 2026-08, is gone), and
# a request for a missing id fails as a 404 NotFoundError.
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Reasoning tokens are billed from MAX_OUTPUT_TOKENS and starve the JSON
# draft on reasoning models. "none" disables them; "low"/"medium"/"high"
# re-enable; empty leaves the provider default.
LLM_REASONING_EFFORT=none
# $ per 1M tokens, from the host's pricing — used for cost accounting.
LLM_IN_RATE_PER_M=0.14
LLM_OUT_RATE_PER_M=0.28

# OCR (T8). rapidocr runs PP-OCRv5 locally on ONNX Runtime and needs no
# credentials; gcv | tesseract | paddleocr | local_stub are the alternatives.
OCR_PROVIDER=rapidocr
# Only read when OCR_PROVIDER=gcv.
GOOGLE_APPLICATION_CREDENTIALS=
OCR_MIN_CONFIDENCE=0.5

# Consent, limits, and timeouts
NOTICE_VERSION=2026-08-11-v4
DAILY_CHECK_LIMIT=5
LLM_TIMEOUT_S=30
OCR_TIMEOUT_S=30
MAX_OUTPUT_TOKENS=600
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Require every red flag to name the detected rule/signal/card it rests on
# (docs/PIPELINE_V2.md §3). Set to false to render model red flags as written.
ANSWER_GROUNDING_ENABLED=true
KNOWLEDGE_ROUTER_ENABLED=false
KNOWLEDGE_ROUTER_BASE_URL=
KNOWLEDGE_ROUTER_API_KEY=
KNOWLEDGE_ROUTER_MODEL=
KNOWLEDGE_ROUTER_TIMEOUT_S=10
# How often the operator-authored rule overrides are merged onto the shipped YAML pack.
RULE_PACK_REFRESH_MINUTES=15
# How often operator-authored knowledge cards are merged onto the shipped YAML base.
KNOWLEDGE_REFRESH_MINUTES=15
KNOWLEDGE_GAP_DEFAULT_DAYS=7
KNOWLEDGE_UNAVAILABLE_ALERT_THRESHOLD=0.20
KNOWLEDGE_UNAVAILABLE_ALERT_WINDOW_MINUTES=30
OPERATOR_ALERT_CHAT_ID=
OPERATOR_ALERT_DEBOUNCE_S=900

# Anonymous web channel (T13)
WEB_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=8000
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_DAILY_LIMIT=5
# Mark the session cookie Secure. Keep true behind HTTPS; false only for
# plain-HTTP local development.
WEB_COOKIE_SECURE=false
# Founder-only editorial post admin. Leave blank to disable /admin completely.
ADMIN_ACCESS_KEY=
